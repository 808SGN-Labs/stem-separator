  <widget class="QStatusBar" name="statusbar" />
  <property name="styleSheet">
   <string>
QMainWindow, QWidget#centralwidget { background: #171b20; color: #e1e6ed; }
QWidget { color: #e1e6ed; font-family: "DejaVu Sans"; font-size: 12px; }
QGroupBox { background: #20262d; border: 1px solid #38414c; border-radius: 8px; margin-top: 10px; padding-top: 8px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; color: #aab8c8; }
QLabel { background: transparent; }
QLabel#experimentLabel, QLabel#blindStatusLabel, QLabel#scaleLegend { color: #aab8c8; font-size: 11px; }
QLabel#currentStemLabel { color: #73d6c6; }
QPushButton { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #343e49,stop:1 #29313b); border: 1px solid #4a5766; border-bottom: 2px solid #101419; border-radius: 5px; padding: 8px 12px; font-weight: 600; }
QPushButton:hover { background: #3d4b59; border-color: #7c8d9f; }
QPushButton:checked, QPushButton:pressed { background: #234c49; color: #91eadb; border: 1px solid #69cabb; }
QPushButton:focus, QRadioButton:focus, QCheckBox:focus { border: 1px solid #e3bd78; }
QPushButton#saveNextButton { background: #73d6c6; color: #122a28; border: 1px solid #9fefdf; border-bottom: 2px solid #387c70; }
QPushButton#saveNextButton:hover { background: #9fefdf; }
QPushButton#playButton { color: #91eadb; }
QPushButton:disabled { color: #6e7b88; background: #242b33; border-color: #343e49; }
QComboBox, QPlainTextEdit { background: #13191f; border: 1px solid #45515e; border-radius: 5px; padding: 6px; selection-background-color: #32685f; }
QComboBox QAbstractItemView { background: #20262d; selection-background-color: #32685f; }
QRadioButton, QCheckBox { spacing: 7px; padding: 4px; }
QGroupBox#blindQcGroup QRadioButton { min-width: 28px; min-height: 28px; padding: 0 3px; background: #171e25; border: 1px solid #475563; border-radius: 4px; }
QGroupBox#blindQcGroup QRadioButton::indicator { width: 0; height: 0; }
QGroupBox#blindQcGroup QRadioButton:checked { background: #73d6c6; color: #122a28; border-color: #a6f0e2; font-weight: 700; }
QGroupBox#blindQcGroup QRadioButton:hover { border-color: #91eadb; }
QSlider::groove:horizontal { height: 5px; background: #10151b; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #62bbae; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0; background: #cce8e4; border-radius: 5px; }
QStatusBar { background: #11171c; color: #aab8c8; }
QToolTip { background: #303b46; color: #ffffff; border: 1px solid #6d8293; padding: 5px; }
</string>
  </property>
 </widget>
